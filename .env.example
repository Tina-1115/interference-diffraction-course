# 複製為 .env（Vercel 請改在專案 Settings > Environment Variables 設定）。.env 不要提交。
# 教師通行碼（必填）。請自訂一組夠長、不易猜的字串；不要使用範例值。
TEACHER_PASSCODE=
# 選填：token／儲存路徑簽章金鑰（建議設定一組隨機長字串；未設則由 TEACHER_PASSCODE 衍生）
TOKEN_SECRET=
# 選填：設定後改用 Vercel Blob；未設定則寫入本機 .data/（僅供本機測試，Vercel 上不會持久）
# 建立 Blob store 時請選「Private」。連結專案後 Vercel 會自動注入此變數。
BLOB_READ_WRITE_TOKEN=
# 'private'（預設，建議）或 'public'；須與 Blob store 存取模式一致
BLOB_ACCESS=private
